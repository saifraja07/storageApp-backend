# Server
PORT=4000
CLIENT_URLS=your-frontend-url
COOKIE_SAMESITE=lax
SESSION_SECRET=your-session-secret

# MongoDB
DB_URL=your-database-url

# Redis
REDIS_URL=your-redis-url
REDIS_PASS=your-redis-pass

# Observability
# true for EC2, false for Lambda
OBSERVABILITY_ENABLED=true

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret-key
REDIRECT_URI=postmessage

# Cloudflare R2 — PRIVATE storage bucket (existing user files, stays private)
R2_BUCKET=your-bucket-name
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Cloudflare R2 — PERSONAL account (optional; only for my selected user IDs listed in PERSONAL_STORAGE_USER_IDS)
# Everyone else keeps using the production R2 variables above.
PERSONAL_R2_BUCKET=your-personal-bucket-name
PERSONAL_R2_ENDPOINT=https://<personal-account-id>.r2.cloudflarestorage.com
PERSONAL_R2_ACCESS_KEY_ID=your-personal-r2-access-key-id
PERSONAL_R2_SECRET_ACCESS_KEY=your-personal-r2-secret-access-key
# Comma-separated trusted MongoDB user _ids that use the personal account
PERSONAL_STORAGE_USER_IDS=user_id_1,user_id_2

# Cloudflare R2 — PUBLIC profile-image bucket (separate bucket, CDN-fronted)
R2_PROFILE_BUCKET_NAME=your-profile-picture-bucket
R2_PROFILE_PUBLIC_URL=https://<your-custom-domain>

# Razorpay
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-secret-key
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Resend (email/OTP)
RESEND_KEY=your-resend-api-key
