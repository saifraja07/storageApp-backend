# Server
PORT=4000
CLIENT_URLS=your-frontend-url
COOKIE_SAMESITE=lax
SESSION_SECRET=your-session-secret

# MongoDB
DB_URL=your-database-url

# Redis
REDIS_URL=your-redis-url
REDIS_PASS=your-redis-pass

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret-key
REDIRECT_URI=postmessage

# Cloudflare R2 — PRIVATE storage bucket (existing user files, stays private)
R2_BUCKET=your-bucket-name
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Cloudflare R2 — PUBLIC profile-image bucket (separate bucket, CDN-fronted)
# Never reused for normal user files, never attached to the private bucket.
R2_PROFILE_BUCKET_NAME=your-profile-picture-bucket
R2_PROFILE_PUBLIC_URL=https://<your-custom-domain>

# Razorpay
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-secret-key
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Resend (email/OTP)
RESEND_KEY=your-resend-api-key
